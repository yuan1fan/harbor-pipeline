{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-pipeline.local/schemas/dataset-manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "created_at", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cve_id", "task_version", "artifact_digest", "project",
          "root_cause_group", "patch_group", "split", "location"
        ],
        "properties": {
          "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
          "task_version": {"type": "string", "minLength": 1},
          "validation_protocol": {"type": "integer"},
          "artifact_digest": {"type": "string", "minLength": 1},
          "project": {"type": "string", "minLength": 1},
          "ecosystem": {"type": "string"},
          "repository": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "task_digest": {"type": "string"},
          "split_group": {"type": "string"},
          "root_cause_group": {"type": "string", "minLength": 1},
          "patch_group": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "validation", "test"]},
          "location": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
