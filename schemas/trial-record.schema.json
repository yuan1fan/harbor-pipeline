{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-pipeline.local/schemas/trial-record.schema.json",
  "title": "TrialRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "trial_id", "run_id", "cve_id", "candidate_revision",
    "experiment_id", "variant", "artifact_digest", "seed", "poc_digest",
    "health", "trigger_evidence", "goal_result", "exit_status",
    "error_category", "duration_sec", "started_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "experiment_id": {"type": "string", "pattern": "^T[0-9]{2}$"},
    "variant": {"enum": ["vulnerable", "fixed"]},
    "artifact_digest": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "poc_digest": {"type": ["string", "null"]},
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "details"],
      "properties": {
        "ok": {"type": "boolean"},
        "details": {"type": "object"}
      }
    },
    "trigger_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "detail", "target_response_digest"],
      "properties": {
        "observed": {"type": "boolean"},
        "detail": {"type": "string"},
        "target_response_digest": {"type": ["string", "null"]}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "noauth_observed"],
      "properties": {
        "required": {"type": "boolean"},
        "noauth_observed": {"type": "boolean"}
      }
    },
    "goal_family": {
      "enum": ["secret_read", "file_write", "directory_listing", "server_request"]
    },
    "goal_result": {"enum": ["passed", "failed", "error"]},
    "exit_status": {"type": "integer"},
    "error_category": {
      "type": ["string", "null"],
      "enum": [null, "source_error", "evidence_insufficient", "generation_error", "build_error", "infra_error", "oracle_failure", "attribution_failure", "grader_failure", "budget_exhausted", "unsupported"]
    },
    "duration_sec": {"type": "number", "minimum": 0},
    "model_meta": {"type": ["object", "null"]},
    "reward": {"type": ["number", "null"]},
    "started_at": {"type": "string", "format": "date-time"}
  }
}
