{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-pipeline.local/schemas/evidence-index.schema.json",
  "title": "EvidenceIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cve_id", "collected_at", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "fetched_at", "content_sha256", "source_type", "citation", "status", "local_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
        "url": {"type": "string", "format": "uri"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_type": {
          "enum": ["cve_record", "vendor_advisory", "upstream_commit", "release_notes", "reproduction_reference", "other"]
        },
        "citation": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "error"]},
        "error": {"type": ["string", "null"]},
        "local_path": {"type": "string", "minLength": 1},
        "media_type": {"type": ["string", "null"]},
        "redirect_chain": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
