# Copy to .env for local runs. The CLI loads .env from the config directory or
# the current directory; real process environment variables take precedence.
# .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=
# Used by claude-cli and by the anthropic provider when accessing a compatible proxy.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# Raises GitHub API limits for discovery/resolver. Only sent to api.github.com.
GITHUB_TOKEN=
# Optional NVD API key.
NVD_API_KEY=
# Models are pinned to deepseek-flash-cyber in pipeline.toml and pipeline.api.toml.
